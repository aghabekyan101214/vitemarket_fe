  },
  "locale": "en",
  "theme": {
    "tokens": {
      "colors": {
        "primary": "#1F3A5F",
        "primary_foreground": "#FFFFFF",
        "secondary": "#E8E1D9",
        "accent": "#C8553D",
        "background": "#FAFAF7",
