{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3300",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://nordic-home-de.localhost:3300/",
        "http://nordic-home-de.localhost:3300/products",
        "http://nordic-home-fr.localhost:3300/",
        "http://nordic-home-fr.localhost:3300/products"
      ],
      "numberOfRuns": 3,
      "settings": { "formFactor": "mobile", "screenEmulation": { "mobile": true } }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": "off",
        "resource-summary:script:size": ["warn", { "maxNumericValue": 102400 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
