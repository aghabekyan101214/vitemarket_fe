# Copy to .env.local. Validated at startup by src/config/env.ts.

# Public API of the backend (server-only, never sent to the browser).
SHOWCASE_API_URL=http://localhost:8000/public/v1
# http = real backend, mock = recorded fixtures in src/lib/api/fixtures (no Docker needed).
SHOWCASE_API_MODE=mock
# Shared with the backend's REVALIDATE_WEBHOOK_SECRET.
REVALIDATE_WEBHOOK_SECRET=local-webhook-secret
# local | staging | production. Anything but production is always noindex.
APP_ENV=local
# Extra host → site key mappings, honored only when APP_ENV != production.
DEV_HOST_ALIASES=localhost=nordic-home-de
# Read X-Forwarded-Host only behind a trusted proxy.
TRUST_FORWARDED_HOST=false
HOST_MAP_TTL_SECONDS=60
# none (raw URLs) | cloudflare (/cdn-cgi/image transformations). Must match the backend.
NEXT_PUBLIC_IMAGE_PROVIDER=none
